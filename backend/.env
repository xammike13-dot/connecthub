PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/olafasta
JWT_SECRET=olafasta_development_jwt_secret_key_1234567890
JWT_EXPIRE=30d
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
BACKEND_URL=http://localhost:5000

# Production CORS origins
# FRONTEND_URL=https://olafasta.com
# CLIENT_URL=https://olafasta.com
# CORS_ORIGIN=https://olafasta.com,https://admin.olafasta.com

# WhatsApp Verification Token
WHATSAPP_VERIFY_TOKEN=olafasta_dev_verify_token

# MPesa Daraja API (Sandbox Mode)
MPESA_ENVIRONMENT=sandbox
