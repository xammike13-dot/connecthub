# ==============================================================================
# OLAFASTA FRONTEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Option A: Fetch from local Express backend (via Vite proxy -> localhost:5000)
VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5000

# Option B: Preview UI locally using live production products (uncomment to use)
# VITE_API_URL=https://connecthub-60j4.onrender.com/api
# VITE_SOCKET_URL=https://connecthub-60j4.onrender.com

# Production values (Configured in Vercel project environment variables)
# VITE_API_URL=https://connecthub-60j4.onrender.com/api
# VITE_SOCKET_URL=https://connecthub-60j4.onrender.com
# VITE_MAINTENANCE_MODE=false

# Google Maps API (Optional, for map navigation)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Cloudinary (Optional, for direct client-side asset uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
